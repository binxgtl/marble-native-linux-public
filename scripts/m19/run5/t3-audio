#!/bin/busybox sh
# T3-audio, R5a's first step, after R1 has started the ADSP and the PC has answered over USB, and before
# anything touches the TEE. Run12's registration observer, read-only (scripts/m11/run12/registration):
# the audio stage must have ended "ready"; then ukee-mtp-snd-card must exist with its control device, a
# playback and a capture PCM, both amplifiers bound as smartpa, the ADSP running and the PD mapper alive,
# the same card in five samples running. Nothing is opened: no PCM, no control, no mixer.
# A failure stops the run here; R1 then sends the log and paints YELLOW.
set -eu
R=${M19_ROOT:-}
BB=${M19_BB:-/bin/busybox}
WAIT=${M19_AUDIO_WAIT:-600}
fail() { printf 'M19 T3 audio failed: %s\n' "$*" >&2 || :; exit 1; }
case "$R" in ''|/*) ;; *) fail root;; esac
[ -z "$R" ] || [ ! -L "$R" ] || fail root
case "$WAIT" in ''|*[!0-9]*) fail wait;; esac
read_value() { $BB cat "$1"; }
# MAJOR:MINOR exactly: digits, one colon, digits.
number_ok() { case "$1" in *[!0-9:]*|:*|*:|*:*:*|'') return 1;; *:*) return 0;; esac; return 1; }

result=$(read_value "$R/run/m19/audio.result") || fail no-stage-result
printf 'M19 T3 audio: stage %s\n' "$result" >&2
[ "$result" = ready ] || fail "stage $result"
# R1's adsp script records the ADSP it started.
adsp=$(read_value "$R/run/m19/adsp.owner") || fail adsp-owner
case "$adsp" in /sys/class/remoteproc/remoteproc[0-9]*) ;; *) fail "adsp owner $adsp";; esac
adsp=$R$adsp
pd_pid=$(read_value "$R/run/m11/pd.pid") || fail mapper-pid
case "$pd_pid" in ''|*[!0-9]*) fail mapper-pid;; esac
mapper_alive() {
 $BB kill -0 "$pd_pid" 2>/dev/null || return 1
 state=$($BB awk '{print $3}' "/proc/$pd_pid/stat" 2>/dev/null || :)
 [ -n "$state" ] && [ "$state" != Z ]
}
[ -f "$R/m19/audio/amps" ] && [ ! -L "$R/m19/audio/amps" ] || fail amps-missing
. "$R/m19/audio/amps"

card_index() { $BB awk '/ukee-mtp-snd-card/ && $1 ~ /^[0-9]+$/ {print $1}' "$R/proc/asound/cards" 2>/dev/null || :; }
# One sample: valid=1 when the card has a control device and both directions of PCM.
sample() {
 card=$(card_index)
 case "$card" in ''|*[!0-9]*) card=;; esac
 devno=; valid=0; prefix=
 if [ -n "$card" ]; then
  prefix=$(printf '%02d-' "$card")
  devno=$(read_value "$R/sys/class/sound/controlC$card/dev" 2>/dev/null || :)
  if number_ok "$devno" && [ "${devno%%:*}" -gt 0 ] && $BB grep -q "^${prefix}.*playback" "$R/proc/asound/pcm" 2>/dev/null &&
     $BB grep -q "^${prefix}.*capture" "$R/proc/asound/pcm" 2>/dev/null; then valid=1; fi
 fi
 amp_snapshot
 adsp_state=$(read_value "$adsp/state" 2>/dev/null || :)
}
i=0; stable=0; stable_card=; previous=
while [ "$i" -lt "$WAIT" ] && [ "$stable" -lt 5 ]; do
 mapper_alive || fail mapper-exited
 sample
 if [ "$valid" -eq 1 ] && [ "$amp_state" = both ] && [ "$adsp_state" = running ]; then
  if [ "$stable_card" = "$card" ]; then stable=$((stable+1)); else stable=1; stable_card=$card; fi
 else
  stable=0; stable_card=
 fi
 now="$card|$devno|$valid|$amp_state|$adsp_state"
 if [ "$now" != "$previous" ] || [ "$stable" -eq 5 ]; then
  printf 'M19 T3 audio: sample=%s card=[%s] control=[%s] valid=%s amps=%s adsp=%s stable=%s\n' "$i" "$card" "$devno" "$valid" "$amp_state" \
   "$adsp_state" "$stable" >&2
  previous=$now
 fi
 $BB sleep 0.1 || fail sleep
 i=$((i+1))
done
# A fresh sample before judging: never a stale success.
mapper_alive || fail mapper-exited
sample
printf 'M19 T3 audio: cards\n' >&2
$BB head -c 8192 "$R/proc/asound/cards" >&2 2>/dev/null || :
printf 'M19 T3 audio: pcm\n' >&2
$BB head -c 8192 "$R/proc/asound/pcm" >&2 2>/dev/null || :
[ "$stable" -eq 5 ] || fail "not stable: card=[$card] valid=$valid amps=$amp_state adsp=$adsp_state"
[ "$card" = "$stable_card" ] && [ "$valid" -eq 1 ] && [ "$amp_state" = both ] && [ "$adsp_state" = running ] ||
 fail "changed: card=[$card] valid=$valid amps=$amp_state adsp=$adsp_state"
printf 'M19 T3 audio: card=%s control=%s amps=both adsp=running mapper=%s registered\n' "$card" "$devno" "$pd_pid" >&2
exit 0
