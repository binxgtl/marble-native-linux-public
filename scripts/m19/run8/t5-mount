#!/bin/busybox sh
# T5 for R8 (docs/m19-r8.md): the unlocked device mounted read-write, without discard, checked read-write in mountinfo.
# f2fs may roll forward what Android last synced; Android's last stop before the run is a clean reboot.
set -eu
R=${M19_ROOT:-}
BB=${M19_BB:-/bin/busybox}
fail() { printf 'M19 T5 failed: %s\n' "$*" >&2 || :; exit 1; }
line=$($BB cat "$R/run/m19/unlock.line") || fail status-file
case "$line" in "M19_UNLOCK status=OK "*" table=rw dev="*) ;; *) fail table;; esac
number=${line##*dev=}
case "$number" in
 *[!0-9:]*|:*|*:|*:*:*|'') fail device-number;;
esac
$BB mknod -m 600 "$R/dev/m19-dm" b "${number%%:*}" "${number#*:}" || fail device-node
$BB mkdir -p "$R/m19-data" || fail mount-point
$BB mount -t f2fs -o rw,noatime,nodiscard,inlinecrypt "$R/dev/m19-dm" "$R/m19-data" || fail mount
options=$($BB awk -v point="$R/m19-data" '$5 == point { o = $6 } END { print o }' "$R/proc/self/mountinfo") || fail mountinfo
case "$options" in rw|rw,*) ;; *) fail "read-write-check $options";; esac
printf 'M19 T5 /data read-write\n' >&2
exit 0
