#!/bin/busybox sh
# T2 to T4 for R8 (docs/m19-r8.md): R1's unlock, with the dm-default-key table read-write for the /data that T5 mounts
# read-write. T0 set the userdata partition read-only for the TEE's start; R8c showed the flag stays under the
# read-write table, so it is cleared here, and checked, before the table loads. Its one status line carries no key
# material, so it can go to the log.
set -eu
R=${M19_ROOT:-}
BB=${M19_BB:-/bin/busybox}
. "$R/m19/pins"
fail() { printf 'M19 T2 failed: %s\n' "$*" >&2 || :; exit 1; }
if [ ! -e "$R/dev/device-mapper" ]; then
 number=$($BB cat "$R/sys/class/misc/device-mapper/dev") || fail control-number
 $BB mknod -m 600 "$R/dev/device-mapper" c "${number%%:*}" "${number#*:}" || fail control-node
fi
[ -e "$R/dev/m19-userdata" ] && [ ! -L "$R/dev/m19-userdata" ] || fail userdata-node
$BB blockdev --setrw "$R/dev/m19-userdata" || fail userdata-writable
[ "$($BB blockdev --getro "$R/dev/m19-userdata")" = 0 ] || fail userdata-writable-check
line=$(LD_LIBRARY_PATH=/system/lib64:/vendor/lib64/hw $BB chroot "$R/tee" /m19/m19-unlock --rw \
 /metadata/vold/metadata_encryption/key m19-userdata /dev/m19-userdata "$USERDATA_SECTORS") || :
printf 'M19 %s\n' "$line" >&2
printf '%s\n' "$line" >"$R/run/m19/unlock.line" || fail status-file
case "$line" in
 "M19_UNLOCK status=OK "*" table=rw dev="*) exit 0;;
 *) exit 1;;
esac
