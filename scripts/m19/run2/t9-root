#!/bin/busybox sh
# T9: the root systemd will run on. /data/ubuntu stays read-only and unchanged: / is a read-only
# bind of it, /etc is a copy in RAM with M19's units and masks on top, and the directories systemd
# writes are tmpfs. Every block device is set read-only first, and the new /dev holds a short list
# of character nodes and no block node at all.
set -eu
R=${M19_ROOT:-}
BB=${M19_BB:-/bin/busybox}
fail() { printf 'M19 T9 failed: %s\n' "$*" >&2 || :; exit 1; }
# Production runs with an empty R, the real root. A test root must be absolute and not a link.
case "$R" in ''|/*) ;; *) fail root;; esac
[ -z "$R" ] || [ ! -L "$R" ] || fail root
. "$R/m19/pins"
plan=$R/m19/r2
src=$R/m19-data/ubuntu
new=$R/newroot
safe_dir() { [ ! -L "$1" ] && [ -d "$1" ]; }
# Checks every component below $1, so no mount can follow a link out of the new root.
safe_path() {
 at=$1; rest=${2#/}
 [ -n "$rest" ] || return 1
 while [ -n "$rest" ]; do
  part=${rest%%/*}
  case "$part" in ''|.|..) return 1;; esac
  at=$at/$part
  safe_dir "$at" || return 1
  case "$rest" in */*) rest=${rest#*/};; *) rest=;; esac
 done
}
number_ok() { case "$1" in *[!0-9:]*|:*|*:|*:*:*|'') return 1;; esac; }

safe_dir "$R/m19-data" && safe_dir "$src" || fail rootfs
[ ! -e "$new" ] && [ ! -L "$new" ] || fail newroot-exists

# 1. Every block device read-only, through nodes in the old /dev. Ubuntu never gets a block node.
blocks=0
for entry in "$R"/sys/class/block/*; do
 [ -e "$entry/dev" ] || continue
 name=${entry##*/}
 case "$name" in ''|*[!A-Za-z0-9._-]*) fail "block name";; esac
 number=$($BB cat "$entry/dev") || fail "block number $name"
 number_ok "$number" || fail "block number $name"
 node=$R/dev/m19-ro-$name
 $BB mknod -m 400 "$node" b "${number%%:*}" "${number#*:}" || fail "block node $name"
 $BB blockdev --setro "$node" || fail "set read-only $name"
 [ "$($BB blockdev --getro "$node")" = 1 ] || fail "read-only check $name"
 blocks=$((blocks+1))
done
[ "$blocks" -gt 0 ] || fail no-block-device

# 2. / is a read-only bind of the tree, checked in mountinfo.
$BB mkdir -m 755 "$new" || fail newroot
$BB mount -o bind "$src" "$new" || fail root-bind
$BB mount -o remount,bind,ro "$new" || fail root-read-only
options=$($BB awk -v point="$new" '$5 == point { o = $6 } END { print o }' "$R/proc/self/mountinfo") || fail mountinfo
case "$options" in ro|ro,*) ;; *) fail "root-read-only-check $options";; esac

# 3. /etc in RAM: a copy, then M19's files, masks and default target on top. The tree is untouched.
safe_path "$new" /etc || fail etc
etc_kb=$($BB du -sk "$src/etc" | $BB awk '{ print $1 }') || fail etc-size
case "$etc_kb" in ''|*[!0-9]*) fail etc-size;; esac
[ "$etc_kb" -le 262144 ] || fail "etc-size $etc_kb"
$BB mount -t tmpfs -o mode=0755,nosuid,nodev,size=512m tmpfs "$new/etc" || fail etc-tmpfs
$BB cp -a "$src/etc/." "$new/etc/" || fail etc-copy
fstab=0
[ ! -f "$src/etc/fstab" ] || fstab=$($BB grep -cvE '^[[:space:]]*(#|$)' "$src/etc/fstab" || :)
# An empty machine-id gives a transient ID. A missing or "uninitialized" one would mean first boot,
# which applies presets and could enable units, so both become empty.
if [ -L "$new/etc/machine-id" ]; then
 machine=link
elif [ ! -e "$new/etc/machine-id" ]; then
 machine=missing; : >"$new/etc/machine-id" || fail machine-id
elif [ ! -s "$new/etc/machine-id" ]; then
 machine=empty
elif $BB grep -qx uninitialized "$new/etc/machine-id"; then
 machine=uninitialized; : >"$new/etc/machine-id" || fail machine-id
else
 machine=present
fi
# Without /etc/selinux/config, libselinux reports SELinux disabled to Ubuntu. The kernel keeps
# TWRP's permissive policy, which cannot be unloaded.
selinux=absent
if [ -e "$new/etc/selinux/config" ] || [ -L "$new/etc/selinux/config" ]; then
 selinux=hidden; $BB rm -f "$new/etc/selinux/config" || fail selinux-config
fi
$BB rm -f "$new/etc/crypttab" || fail crypttab
default=$($BB readlink "$new/etc/systemd/system/default.target" || echo none)
$BB mkdir -p "$new/etc/systemd/system" "$new/etc/systemd/system-generators" || fail unit-directories
masks=0
while read -r unit; do
 case "$unit" in ''|'#'*) continue;; esac
 case "$unit" in .*|*[!A-Za-z0-9@._:-]*) fail "unit name $unit";; esac
 case "$unit" in *.service|*.socket|*.target|*.timer|*.path|*.mount) ;; *) fail "unit type $unit";; esac
 path=$new/etc/systemd/system/$unit
 if [ -d "$path" ] && [ ! -L "$path" ]; then fail "unit directory $unit"; fi
 $BB rm -f "$path" || fail "unmask $unit"
 $BB ln -s /dev/null "$path" || fail "mask $unit"
 masks=$((masks+1))
done <"$plan/masks"
generators=0
while read -r name; do
 case "$name" in ''|'#'*) continue;; esac
 case "$name" in .*|*[!A-Za-z0-9._-]*) fail "generator name $name";; esac
 path=$new/etc/systemd/system-generators/$name
 if [ -d "$path" ] && [ ! -L "$path" ]; then fail "generator directory $name"; fi
 $BB rm -f "$path" || fail "unmask generator $name"
 $BB ln -s /dev/null "$path" || fail "mask generator $name"
 generators=$((generators+1))
done <"$plan/generators"
files=0
while read -r file; do
 case "$file" in ''|'#'*) continue;; esac
 case "$file" in /*|.*|*/.*|*[!A-Za-z0-9@._/-]*) fail "plan file $file";; esac
 case "$file" in */*) $BB mkdir -p "$new/etc/${file%/*}" || fail "plan directory $file";; esac
 $BB rm -f "$new/etc/$file" || fail "plan file $file"
 $BB cp "$plan/etc/$file" "$new/etc/$file" || fail "plan file $file"
 $BB chmod 644 "$new/etc/$file" || fail "plan file $file"
 files=$((files+1))
done <"$plan/files"
$BB rm -f "$new/etc/systemd/system/default.target" || fail default-target
$BB ln -s m19-r2.target "$new/etc/systemd/system/default.target" || fail default-target

# 4. tmpfs where systemd writes. Each mount point must already exist: the tree cannot grow one.
tmpfs=0
while read -r point mode size; do
 case "$point" in ''|'#'*) continue;; esac
 case "$point" in /*) ;; *) fail "tmpfs path $point";; esac
 case "$point" in *[!A-Za-z0-9/._-]*) fail "tmpfs path $point";; esac
 case "$mode" in [0-7][0-7][0-7][0-7]) ;; *) fail "tmpfs mode $point";; esac
 case "$size" in [1-9]*m) ;; *) fail "tmpfs size $point";; esac
 safe_path "$new" "$point" || fail "mount point $point"
 $BB mount -t tmpfs -o "mode=$mode,nosuid,nodev,size=$size" tmpfs "$new$point" || fail "tmpfs $point"
 tmpfs=$((tmpfs+1))
done <"$plan/tmpfs"

# 5. /dev with the listed character nodes only, then proc and sysfs.
safe_path "$new" /dev && safe_path "$new" /proc && safe_path "$new" /sys || fail api-mount-points
$BB mount -t tmpfs -o mode=0755,nosuid,noexec,size=1m tmpfs "$new/dev" || fail dev-tmpfs
nodes=0
while read -r name class mode; do
 case "$name" in ''|'#'*) continue;; esac
 case "$name" in /*|.*|*/.*|*[!a-z0-9/A-Z_-]*) fail "node name $name";; esac
 case "$class" in */*/*|*[!a-z0-9/A-Z_-]*|/*|*/) fail "node class $name";; esac
 case "$class" in mem/*|tty/*|drm/*) ;; *) fail "node class $name";; esac
 case "$mode" in [0-7][0-7][0-7]) ;; *) fail "node mode $name";; esac
 number=$($BB cat "$R/sys/class/$class/dev") || fail "char number $name"
 number_ok "$number" || fail "char number $name"
 case "$name" in */*) $BB mkdir -p "$new/dev/${name%/*}" || fail "node directory $name";; esac
 $BB mknod -m "$mode" "$new/dev/$name" c "${number%%:*}" "${number#*:}" || fail "char node $name"
 nodes=$((nodes+1))
done <"$plan/nodes"
$BB mount -t proc -o nosuid,nodev,noexec proc "$new/proc" || fail proc
$BB mount -t sysfs -o nosuid,nodev,noexec sysfs "$new/sys" || fail sysfs

# 6. The reporter is this PID 1's own binary; the display paints its verdict.
$BB mkdir -p "$new/run/m19" || fail run-m19
$BB cp "$R/sbin/m19-pid1" "$new/run/m19/m19-report" || fail reporter
$BB cp "$R/sbin/m16-display" "$new/run/m19/m16-display" || fail display
$BB chmod 755 "$new/run/m19/m19-report" "$new/run/m19/m16-display" || fail run-modes

# 7. The init that PID 1 will exec is the one T6 hashed, seen through the new root.
hash=$($BB sha256sum "$new/$ROOTFS_PROBE") || fail probe-read
[ "${hash%% *}" = "$ROOTFS_PROBE_SHA256" ] || fail probe-hash
for tool in usr/bin/systemctl usr/bin/journalctl usr/bin/systemd-analyze; do
 [ -x "$new/$tool" ] || fail "missing $tool"
done
printf 'M19 T9 new root: blocks-read-only=%s etc=%sK machine-id=%s fstab-lines=%s selinux-config=%s default-was=%s\n' \
 "$blocks" "$etc_kb" "$machine" "$fstab" "$selinux" "$default" >&2
printf 'M19 T9 masks=%s generators=%s files=%s tmpfs=%s nodes=%s\n' "$masks" "$generators" "$files" "$tmpfs" "$nodes" >&2
wants=$($BB ls "$src/etc/systemd/system/multi-user.target.wants" 2>/dev/null | $BB tr '\n' ' ' || :)
printf 'M19 T9 multi-user wants: %s\n' "$wants" >&2
exit 0
