#!/bin/sh
# M18 R1 (docs/m18-performance-polish.md): the session's performance and power record, read-only. Every PERIOD
# seconds one line into /var/lib/m19/m18-perf.log: the boot clock, each CPU policy's frequency and governor, the GPU's
# clock, every thermal zone, the battery's voltage, current, capacity and temperature, the load and the memory
# available. A header line names the policies and the zones once a boot. At LIMIT bytes the file moves to .1.
# It writes nothing anywhere else and sets nothing. M18_SYS, M18_PROC, M18_LOG, M18_PERIOD and M18_COUNT are for the
# tests (M18_COUNT: stop after that many lines; 0, the default, never).
set -u
SYS=${M18_SYS:-/sys}
PROC=${M18_PROC:-/proc}
LOG=${M18_LOG:-/var/lib/m19/m18-perf.log}
PERIOD=${M18_PERIOD:-5}
COUNT=${M18_COUNT:-0}
LIMIT=${M18_LIMIT:-1048576}

read_value() {
  v=
  if [ -r "$1" ]; then
    read -r v <"$1" 2>/dev/null || :
  fi
  v=${v:--}
}

value() {
  read_value "$1"
  printf '%s' "$v"
}

rotate() {
  [ -f "$LOG" ] && [ "$(wc -c <"$LOG")" -ge "$LIMIT" ] && mv -f "$LOG" "$LOG.1"
}

write_header() {
  printf '%s %s\n' "$1" "$header" >>"$LOG"
}

policies=$(ls -d "$SYS"/devices/system/cpu/cpufreq/policy* 2>/dev/null || :)
zones=$(ls -d "$SYS"/class/thermal/thermal_zone* 2>/dev/null || :)
header="M18 perf v1 period=$PERIOD policies="
for p in $policies; do header="$header${p##*/}($(value "$p/related_cpus" | tr ' ' '.')),"; done
header="$header zones="
for z in $zones; do read_value "$z/type"; header="$header$v,"; done
rotate || :
read_value "$PROC/uptime"
write_header "${v%% *}"

n=0
while :; do
  read_value "$PROC/uptime"
  stamp=${v%% *}
  line="$stamp cpu="
  for p in $policies; do
    read_value "$p/scaling_cur_freq"
    line="$line$v/"
    read_value "$p/scaling_governor"
    line="$line$v,"
  done
  read_value "$SYS/class/kgsl/kgsl-3d0/gpuclk"
  line="$line gpu=$v"
  line="$line tz="
  for z in $zones; do read_value "$z/temp"; line="$line$v,"; done
  b=$SYS/class/power_supply/battery
  line="$line bat=$(value "$b/voltage_now"),$(value "$b/current_now"),$(value "$b/capacity"),$(value "$b/temp")"
  line="$line load=$(value "$PROC/loadavg" | cut -d ' ' -f 1-3 | tr ' ' ',')"
  line="$line mem=$(grep -m 1 '^MemAvailable:' "$PROC/meminfo" 2>/dev/null | tr -s ' ' | cut -d ' ' -f 2)"
  if rotate; then write_header "$stamp"; fi
  printf '%s\n' "$line" >>"$LOG"
  n=$((n + 1))
  if [ "$COUNT" -gt 0 ] && [ "$n" -ge "$COUNT" ]; then
    exit 0
  fi
  sleep "$PERIOD"
done
